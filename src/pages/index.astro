      <div class="card">
        <div class="photo-wrap"><img class="photo" src="data:image/jpeg;base64," alt="Conferences &amp; Workshops" loading="lazy"></div>
        <div class="card-body">
        <div class="icon"><svg viewBox="0 0 24 24"><path d="M4 19V5a2 2 0 0 1 2-2h9l5 5v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><path d="M14 3v5h5M8 13h8M8 17h6"/></svg></div>
        <h3>Conferences &amp; Workshops</h3>
        <p class="teaser">Knowledge exchange and strategic skill-building designed for nonprofit leaders.</p>
        <div class="detail"><ul>
          <li>Speaker &amp; agenda curation</li>
          <li>Breakout facilitation</li>
          <li>Attendee experience</li>
        </ul></div>
        <div class="hint">Hover for details</div>
        <button class="book-btn" onclick="bookCall('Conferences & Workshops')">Book a call</button>
      </div></div>
      <div class="card">
        <div class="photo-wrap"><img class="photo" src="data:image/jpeg;base64," alt="Cultural &amp; Academic" loading="lazy"></div>
        <div class="card-body">
        <div class="icon"><svg viewBox="0 0 24 24"><path d="M12 3L2 9l10 6 10-6-10-6z"/><path d="M6 12v5c0 1 3 3 6 3s6-2 6-3v-5"/></svg></div>
        <h3>Cultural &amp; Academic</h3>
        <p class="teaser">Bridging communities and academic research through immersive, cause-driven programming.</p>
        <div class="detail"><ul>
          <li>Cultural showcases</li>
          <li>Research symposiums</li>
          <li>Community programming</li>
        </ul></div>
        <div class="hint">Hover for details</div>
        <button class="book-btn" onclick="bookCall('Cultural & Academic')">Book a call</button>
      </div></div>
      <div class="card">
