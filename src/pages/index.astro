---
import Layout from '../layouts/Layout.astro';
---
<Layout>
    

  <div id="loader">
    <div class="assembly">
      <img class="ly-globe"  src="/images/image_2.png"  alt="">
      <img class="ly-bridge" src="/images/image_3.png" alt="">
      <img class="ly-word"   src="/images/image_4.png"   alt="Purpose Bridge">
      <img class="ly-adv"    src="/images/image_5.png"    alt="Advisory">
    </div>
  </div>


<header>
  <div class="menu-wrap" id="menuWrap">
    <button class="menu-btn" onclick="toggleMenu(event)" aria-label="Menu">
      <span class="bars"><i></i><i></i><i></i></span><span class="label">Menu</span>
    </button>
    <div class="menu-drop" id="menuDrop">
      <button data-tab="home" onclick="goTab('home')"><svg viewBox="0 0 24 24"><path d="M3 11l9-7 9 7M5 10v10h14V10"/></svg>Home</button>
      <button data-tab="services" onclick="goTab('services')"><svg viewBox="0 0 24 24"><path d="M9 3h6M4 8h16v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zM4 8l2-4h12l2 4"/></svg>Services</button>
      <button data-tab="team" onclick="goTab('team')"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/></svg>Team</button>
      <button data-tab="contact" onclick="goTab('contact')"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>Contact</button>
    </div>
  </div>
  <div class="brand"><img src="/images/image_6.png" alt="Purpose Bridge"></div>
  <div class="lang-switch" role="group" aria-label="Language">
    <button data-lang="en" onclick="setLang('en')" lang="en">EN</button>
    <button data-lang="it" onclick="setLang('it')" lang="it">IT</button>
  </div>
</header>

<main class="wrap">

  <!-- ================= HOME ================= -->
  <section class="panel active" id="home">
    <section class="hero">
      <div class="hero-inner">
        <h1>Building bridges for social impact.</h1>
        <p>Partnerships, experiences and collaboration — connecting corporations, universities and institutions with the expertise, counsel and access they need.</p>
        <div class="hero-btns">
          <button class="btn-primary" onclick="goTab('services')">Our Services</button>
          <button class="btn-ghost" onclick="goTab('contact')">Let's Connect</button>
        </div>
      </div>
    </section>

    <div class="home-intro">
      <div class="eyebrow">Who We Are</div>
      <h2>A boutique advisory firm for a complex world.</h2>
      <p>We connect corporations, universities and institutions with the expertise, counsel and access they need to navigate complexity — across digital risk, curated expertise, cross-border law and global leadership development.</p>
    </div>

    <div class="practice-strip">
      <button class="p-mini" onclick="goPillar('p-ai')">
        <div class="g-icon"><svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><circle cx="12" cy="11" r="2"/><path d="M12 13v3"/></svg></div>
        <div class="p-text">
          <span class="p-num">01</span>
          <h3>AI, Security &amp; Privacy Consultancy</h3>
          <p>Cybersecurity, data protection, AI governance and online safety — one advisory team for a complex digital risk landscape.</p>
          <span class="more">Explore &rarr;</span>
        </div>
        <svg class="chev" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
      </button>
      <button class="p-mini" onclick="goPillar('p-speakers')">
        <div class="g-icon"><svg viewBox="0 0 24 24"><path d="M12 3a3 3 0 0 1 3 3v5a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3z"/><path d="M6 11a6 6 0 0 0 12 0M12 17v4M9 21h6"/></svg></div>
        <div class="p-text">
          <span class="p-num">02</span>
          <h3>Speakers Bureau</h3>
          <p>Curated experts for foreign affairs, cultural institutions, universities and museum patron programmes.</p>
          <span class="more">Explore &rarr;</span>
        </div>
        <svg class="chev" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
      </button>
      <button class="p-mini" onclick="goPillar('p-law')">
        <div class="g-icon"><svg viewBox="0 0 24 24"><path d="M12 3v17M7 21h10M5 7h14M5 7l-3 6a3 3 0 0 0 6 0zM19 7l-3 6a3 3 0 0 0 6 0z"/></svg></div>
        <div class="p-text">
          <span class="p-num">03</span>
          <h3>Cross-Border Legacy, Law &amp; Philanthropy</h3>
          <p>Business law, institutional compliance and estate planning — one advisory relationship across borders.</p>
          <span class="more">Explore &rarr;</span>
        </div>
        <svg class="chev" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
      </button>
      <button class="p-mini" onclick="goPillar('p-gya')">
        <div class="g-icon"><svg viewBox="0 0 24 24"><path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c0 1.5 3 3 6 3s6-1.5 6-3v-5M22 9v6"/></svg></div>
        <div class="p-text">
          <span class="p-num">04</span>
          <h3>Global Youth Ambassadors</h3>
          <p>Alumni mentorship and peer support for international university students abroad.</p>
          <span class="more">Explore &rarr;</span>
        </div>
        <svg class="chev" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
      </button>
    </div>
    <p class="strip-tag">Four advisory practices. One relationship.</p>

    <div class="reach">
      <div class="eyebrow">Who We Work With</div>
      <h2>One relationship, across borders.</h2>
      <p>Clients come to us from every side of the table — and increasingly, from more than one country at once.</p>
      <div class="audience">
        <div class="aud"><b>Corporations</b><span>Digital risk, cross-border legal strategy and sponsorship.</span></div>
        <div class="aud"><b>Universities</b><span>Speakers, compliance and student mentorship programmes.</span></div>
        <div class="aud"><b>Institutions &amp; NGOs</b><span>Governance, advancement and international expertise.</span></div>
        <div class="aud"><b>Families &amp; Individuals</b><span>Estate planning, asset protection and legacy giving.</span></div>
      </div>
    </div>

    <div class="home-cta">
      <h3>Building bridges that create lasting social impact.</h3>
      <p>Let's talk about which of our practices fits what you're building.</p>
      <button onclick="goTab('contact')">Start a Conversation</button>
    </div>
  </section>

  <!-- ================= SERVICES ================= -->
  <section class="panel" id="services">
    <div class="panel-head">
      <div class="eyebrow">What We Do</div>
      <h2>Four advisory practices. One relationship.</h2>
      <p>Choose a practice to explore it in detail, or book a call and we'll help you decide which fits.</p>
    </div>
    <div class="grid four">
      <div class="card">
        <div class="photo-wrap"><img class="photo" src="/images/image_7.jpg" alt="AI, Security &amp; Privacy Consultancy" loading="lazy"></div>
        <div class="card-body">
        <div class="icon"><svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><circle cx="12" cy="11" r="2"/><path d="M12 13v3"/></svg></div>
        <h3>AI, Security &amp; Privacy Consultancy</h3>
        <p class="teaser">Cybersecurity, data protection, AI governance and online safety — one advisory team for a complex digital risk landscape.</p>
        <div class="pillar-actions">
          <button class="explore-btn" onclick="goPillar('p-ai')">Explore</button>
          <button class="book-btn" onclick="bookCall('AI, Security &amp; Privacy Consultancy')">Book a call</button>
        </div>
        </div>
      </div>

      <div class="card">
        <div class="photo-wrap"><img class="photo" src="/images/image_8.jpg" alt="Speakers Bureau" loading="lazy"></div>
        <div class="card-body">
        <div class="icon"><svg viewBox="0 0 24 24"><path d="M12 3a3 3 0 0 1 3 3v5a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3z"/><path d="M6 11a6 6 0 0 0 12 0M12 17v4M9 21h6"/></svg></div>
        <h3>Speakers Bureau</h3>
        <p class="teaser">Curated experts for foreign affairs, cultural institutions, universities and museum patron programmes.</p>
        <div class="pillar-actions">
          <button class="explore-btn" onclick="goPillar('p-speakers')">Explore</button>
          <button class="book-btn" onclick="bookCall('Speakers Bureau')">Book a call</button>
        </div>
        </div>
      </div>

      <div class="card">
        <div class="photo-wrap"><img class="photo" src="/images/image_9.jpg" alt="Cross-Border Legacy, Law &amp; Philanthropy" loading="lazy"></div>
        <div class="card-body">
        <div class="icon"><svg viewBox="0 0 24 24"><path d="M12 3v17M7 21h10M5 7h14M5 7l-3 6a3 3 0 0 0 6 0zM19 7l-3 6a3 3 0 0 0 6 0z"/></svg></div>
        <h3>Cross-Border Legacy, Law &amp; Philanthropy</h3>
        <p class="teaser">Business law, institutional compliance and estate planning — one advisory relationship across borders.</p>
        <div class="pillar-actions">
          <button class="explore-btn" onclick="goPillar('p-law')">Explore</button>
          <button class="book-btn" onclick="bookCall('Cross-Border Legacy, Law &amp; Philanthropy')">Book a call</button>
        </div>
        </div>
      </div>

      <div class="card">
        <div class="photo-wrap"><img class="photo" src="/images/image_10.jpg" alt="Global Youth Ambassadors" loading="lazy"></div>
        <div class="card-body">
        <div class="icon"><svg viewBox="0 0 24 24"><path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c0 1.5 3 3 6 3s6-1.5 6-3v-5M22 9v6"/></svg></div>
        <h3>Global Youth Ambassadors</h3>
        <p class="teaser">Alumni mentorship and peer support for international university students abroad.</p>
        <div class="pillar-actions">
          <button class="explore-btn" onclick="goPillar('p-gya')">Explore</button>
          <button class="book-btn" onclick="bookCall('Global Youth Ambassadors')">Book a call</button>
        </div>
        </div>
      </div>
    </div>

    <div class="practice" id="p-ai">
      <div class="practice-head">
        <div>
          <div class="practice-num">Practice One</div>
          <h2>AI, Security &amp; Privacy Consultancy</h2>
          <p class="lede">Cybersecurity, data protection, AI governance and online safety — one advisory team of global experts for organisations navigating a complex digital risk landscape.</p>
        </div>
        <button class="book-btn" onclick="bookCall('AI, Security &amp; Privacy Consultancy')">Book a call</button>
      </div>
      <div class="areas">
        <div class="area"><h4>Cybercrime, Compliance &amp; Investigations</h4><p>International cybercrime and corruption investigations, drawing on government and major global technology-company experience, plus compliance and risk management for emerging privacy and technology regulation.</p></div>
        <div class="area"><h4>Data Protection &amp; Corporate Governance</h4><p>International data protection compliance, including GDPR and NIS2, paired with board-level legal risk governance for organisations operating across borders.</p></div>
        <div class="area"><h4>AI Adoption &amp; Readiness</h4><p>AI integration and organisational readiness for global teams — real-world strategy and ethical grounding for adopting AI, not just technical deployment.</p></div>
        <div class="area"><h4>Online Safety &amp; Cyberharassment Policy</h4><p>Online safety and cyberharassment policy, including international regulatory work to counter harassment and cyberviolence.</p></div>
      </div>
      <div class="sub-label">How it works</div>
      <div class="steps3">
        <div class="step3"><span class="n">01</span><h5>Tell us the challenge</h5><p>An audit, a training programme, an ongoing retainer, or a mix — every engagement is different.</p></div>
        <div class="step3"><span class="n">02</span><h5>We scope, then price</h5><p>No fixed packages. We scope the engagement to your organisation first.</p></div>
        <div class="step3"><span class="n">03</span><h5>Matched by expertise</h5><p>The right expert, or combination of experts, matched to what you need.</p></div>
      </div>
      <p class="experts-line">Experts in this practice include <a onclick="goTab('team')">Cristina Posa</a> and <a onclick="goTab('team')">Tia Christopher</a>.</p>
    </div>

    <div class="practice" id="p-speakers">
      <div class="practice-head">
        <div>
          <div class="practice-num">Practice Two</div>
          <h2>Speakers Bureau</h2>
          <p class="lede">Curated experts for foreign affairs, cultural institutions, universities and museum patron programmes, drawn from a global, cross-border network.</p>
        </div>
        <button class="book-btn" onclick="bookCall('Speakers Bureau')">Book a call</button>
      </div>
      <div class="areas">
        <div class="area"><h4>Culture, Art History &amp; Restoration</h4><p>Our highest-yielding, most-requested lane.</p></div>
        <div class="area"><h4>AI, Governance &amp; Human Dignity</h4><p>Policy and technology for corporate briefings.</p></div>
        <div class="area"><h4>International Affairs &amp; DEI</h4><p>Business schools, chambers of commerce and diplomatic networks.</p></div>
        <div class="area"><h4>Academic &amp; Institutional Circuit</h4><p>International university lecture series.</p></div>
      </div>
      <div class="sub-label">How to book</div>
      <div class="steps3">
        <div class="step3"><span class="n">01</span><h5>Tell us about your event</h5><p>Audience, date, format and budget.</p></div>
        <div class="step3"><span class="n">02</span><h5>We match the right speaker</h5><p>From our roster, matched by fit.</p></div>
        <div class="step3"><span class="n">03</span><h5>We handle the rest</h5><p>Agreements, fees, travel and logistics.</p></div>
      </div>
    </div>

    <div class="practice" id="p-law">
      <div class="practice-head">
        <div>
          <div class="practice-num">Practice Three</div>
          <h2>Cross-Border Legacy, Law &amp; Philanthropy</h2>
          <p class="lede">Business law, institutional compliance and estate planning are usually three separate relationships with three advisors who never talk to each other. Purpose Bridge coordinates all three.</p>
        </div>
        <button class="book-btn" onclick="bookCall('Cross-Border Legacy, Law &amp; Philanthropy')">Book a call</button>
      </div>
      <div class="areas three">
        <div class="area"><h4>International Business Law</h4><p>Entity structuring, contracts and legal strategy for companies operating in more than one country.</p></div>
        <div class="area"><h4>International Law for Universities &amp; NGOs</h4><p>Cross-border legal and advancement programme support for global institutions.</p></div>
        <div class="area"><h4>Estate Planning, Asset Protection &amp; Legacy Giving</h4><p>Coordinated tax, legal and philanthropic strategy for families and individuals living across borders.</p></div>
      </div>
      <div class="note">We advise and structure — connecting clients to the right vehicles and outside partners. We don't hold a donor-advised fund, manage a charity, or monitor compliance as an ongoing service. That independence is what keeps our advice ours, not a product's.</div>
    </div>

    <div class="practice" id="p-gya">
      <div class="practice-head">
        <div>
          <div class="practice-num">Practice Four</div>
          <h2>Global Youth Ambassadors</h2>
          <p class="lede">Alumni mentorship and peer support for international university students abroad — a programme universities license and companies sponsor.</p>
        </div>
        <button class="book-btn" onclick="bookCall('Global Youth Ambassadors')">Book a call</button>
      </div>
      <div class="areas">
        <div class="area"><h4>Global Peer Support Circles</h4><p>Weekly, facilitator-led groups addressing homesickness, culture shock and isolation — delivered through cross-border dialogues with trained facilitators.</p></div>
        <div class="area"><h4>Alumni Mentorship &amp; Networking</h4><p>A monthly guidance programme from alumni to current students, anchored by an annual in-person Ambassadors Summit.</p></div>
      </div>
      <div class="sub-label">How to participate</div>
      <div class="areas">
        <div class="area"><h4>University License</h4><p>A flat fee banded by cohort size, up to 100 students, covering both layers, licensing and coordination. Custom, scope-based pricing following a needs assessment.</p></div>
        <div class="area"><h4>Corporate Sponsorship</h4><p>&ldquo;Sponsor a Cohort&rdquo;: 3–5 executive mentors, Summit visibility and a recruiting pipeline. Priced once we understand your goals.</p></div>
      </div>
    </div>

  </section>

  <!-- ================= TEAM ================= -->
  <section class="panel" id="team">
    <div class="panel-head">
      <div class="eyebrow">Who We Are</div>
      <h2>Our Team</h2>
      <p>Leadership and a network of global experts — one advisory team.</p>
    </div>

    <div class="team-group"><h3>Leadership</h3></div>
    <div class="team-member">
      <img class="team-photo" src="/images/image_11.jpg" alt="Silvia Anna Zamarripa">
      <div class="team-info">
        <div class="role">Founder &amp; Principal</div>
        <h3>Silvia Anna Zamarripa</h3>
        <div class="bio-clip"><p>Silvia Anna Zamarripa is an American international relations and strategic partnerships leader based in Italy, known for building bridges between institutions, communities, and cultures. Her work spans diplomacy, stakeholder relations, education, cultural heritage, and international cooperation, with a focus on creating opportunities that foster meaningful dialogue, collaboration, and long-term value.</p>
        <p>As Founder and Principal of Purpose Bridge, she helps nonprofits, cultural institutions, educational programs, foundations, and mission-driven organizations transform vision into action — through strategic partnership development, communications, branding, stakeholder relations, and event-led initiatives. Guided by the philosophy of "Bridging Purpose and Impact," the consultancy serves as a catalyst for collaboration across sectors, disciplines, and borders.</p>
        <p>Silvia serves as President of the American Club of Rome, leading initiatives that support the integration of Americans and other international residents in Italy through cultural programming, professional networking, and community-building. She also sits on the Board of Directors of the Association of American Clubs, strengthening ties among American clubs worldwide.</p>
        <p>In 2026 she became a Founding Board Member and President of Global Youth Ambassadors, an international initiative preparing the next generation of leaders through diplomacy, intercultural dialogue, and global citizenship. She also serves as Ambassador to the Americans in Italy for We the Italians, promoting stronger connections between American and Italian communities.</p>
        <p>A passionate advocate for education and civic responsibility, Silvia established the President's Award for Academic and Community Excellence, an annual recognition honoring students at The American University of Rome who demonstrate both outstanding academic achievement and meaningful contributions to their communities. She also supports cultural heritage initiatives encouraging conservation, public awareness, and responsible stewardship of Italy's historic and artistic treasures.</p>
        </div>
        <button class="read-more" onclick="toggleBio(this)">Read more</button>
        <div class="creds">
          <div class="creds-label">Leadership &amp; Affiliations</div>
          <div class="cred-grid">
            <div class="cred"><span class="r">President</span><span class="o">American Club of Rome</span></div>
            <div class="cred"><span class="r">Board of Directors</span><span class="o">Association of American Clubs</span></div>
            <div class="cred"><span class="r">President &amp; Founding Board Member</span><span class="o">Global Youth Ambassadors</span></div>
            <div class="cred"><span class="r">Delegate for Texas</span><span class="o">Confassociazioni — Italian Confederation of Professional Associations</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="team-member">
      <img class="team-photo" src="/images/image_12.jpg" alt="Linda Spencer">
      <div class="team-info">
        <div class="role">Principal, Strategic Partnerships</div>
        <h3>Linda Spencer</h3>
        <div class="bio-clip">
          <p>Linda Spencer brings over two decades of strategy, operations and development leadership across the United States and Europe. She currently advises and supports global teams on systems streamlining and AI integration.</p>
          <p>Before her consulting work, she raised more than $200 million working with high-net-worth boards on major gifts, estate and legacy planning, and capital campaigns at Covenant House International, the Inner-City Scholarship Fund and the Archdiocese of New York.</p>
          <p>Having lived or worked in more than eight countries across the Americas and Europe, she brings a genuinely cross-border lens to client engagements. Linda holds a Master of Arts in Social and Organizational Psychology from Columbia University's Teachers College and a Bachelor of Arts from St. John's University.</p>
        </div>
        <button class="read-more" onclick="toggleBio(this)">Read more</button>
        <div class="creds">
          <div class="creds-label">Education &amp; Background</div>
          <div class="cred-grid">
            <div class="cred"><span class="r">M.A., Social &amp; Organizational Psychology</span><span class="o">Teachers College, Columbia University</span></div>
            <div class="cred"><span class="r">B.A.</span><span class="o">St. John&rsquo;s University</span></div>
            <div class="cred"><span class="r">Development leadership</span><span class="o">Covenant House International · Inner-City Scholarship Fund · Archdiocese of New York</span></div>
            <div class="cred"><span class="r">Current focus</span><span class="o">Systems streamlining &amp; AI integration for global teams</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="team-member">
      <img class="team-photo" src="/images/image_13.jpg" alt="Savas Vikos">
      <div class="team-info">
        <div class="role">Senior Advisor, Strategic Partnerships</div>
        <h3>Savas Vikos</h3>
        <div class="bio-clip">
          <p>Savas brings multidisciplinary experience across business development and complex negotiations with discerning international clients. He works with strategic partners across the United States and Europe, spanning key markets including Dubai, Hong Kong, New York, Miami, London, Paris, Berlin, Geneva and Luxembourg.</p>
          <p>Before his consulting work, Savas held roles at Fortune 500 companies, where he developed his approach to understanding client objectives and building solutions around them.</p>
          <p>His practice rests on the conviction that a strong business partnership is built on responsiveness, credibility, trust and integrity — not on the transaction alone.</p>
        </div>
        <button class="read-more" onclick="toggleBio(this)">Read more</button>
        <div class="creds">
          <div class="creds-label">Focus &amp; Markets</div>
          <div class="cred-grid">
            <div class="cred"><span class="r">Practice</span><span class="o">Business development &amp; complex negotiations</span></div>
            <div class="cred"><span class="r">Background</span><span class="o">Fortune 500 companies</span></div>
            <div class="cred"><span class="r">Americas &amp; Asia</span><span class="o">New York · Miami · Dubai · Hong Kong</span></div>
            <div class="cred"><span class="r">Europe</span><span class="o">London · Paris · Berlin · Geneva · Luxembourg</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="team-group"><h3>Expert Network</h3></div>
    <div class="team-member">
      <img class="team-photo" src="/images/image_14.jpg" alt="Cristina Posa">
      <div class="team-info">
        <div class="role">Cybercrime, Compliance &amp; Investigations</div>
        <h3>Cristina Posa</h3>
        <div class="bio-clip">
          <p>Cristina Posa is a lawyer and leader with two decades of experience on the cutting edge of technology and international investigations. A graduate of Harvard Law School and Johns Hopkins University, she served as a U.S. federal prosecutor in New York, where she founded the office's cybercrime unit, and then as the U.S. Department of Justice Attaché to the U.S. Embassy in Rome.</p>
          <p>Among other honours, Cristina won the Prosecutor of the Year award from the Federal Law Enforcement Foundation for dismantling a complex cybercrime syndicate. After more than a decade of public service, she founded and led Amazon's Counterfeit Crimes Unit and then led a legal team at Meta for Europe, the Middle East and Africa.</p>
          <p>She is currently a Cybercrime Expert for the Council of Europe, where her projects include working with Ukraine to use digital evidence in war crimes cases, and a Senior Advisor in the Forensic Investigations and Intelligence practice at RSM Italy. She is also a Lecturer in Law at John Cabot University in Rome, teaching the law and politics of artificial intelligence and cybersecurity, and publishes on emerging issues in cybersecurity, AI and international investigations.</p>
        </div>
        <button class="read-more" onclick="toggleBio(this)">Read more</button>
        <div class="creds">
          <div class="creds-label">Current Roles &amp; Education</div>
          <div class="cred-grid">
            <div class="cred"><span class="r">Cybercrime Expert</span><span class="o">Council of Europe</span></div>
            <div class="cred"><span class="r">Senior Advisor, Forensic Investigations &amp; Intelligence</span><span class="o">RSM Italy</span></div>
            <div class="cred"><span class="r">Lecturer in Law</span><span class="o">John Cabot University, Rome</span></div>
            <div class="cred"><span class="r">Education</span><span class="o">Harvard Law School · Johns Hopkins University</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="team-member">
      <img class="team-photo" src="/images/image_15.jpg" alt="Tia Christopher">
      <div class="team-info">
        <div class="role">Founder &amp; CEO, The Orange Peel Collaborative</div>
        <h3>Tia Christopher</h3>
        <div class="bio-clip">
          <p>Tia helps municipalities, nonprofits and businesses adopt emerging technologies responsibly — through AI governance, workplace transformation and practical implementation strategy.</p>
          <p>A U.S. Navy veteran recognised by the Obama White House as a Woman Veteran Champion of Change, she most recently supported the City of Pittsburgh's generative AI rollout.</p>
          <p>Her approach rests on one principle: successful AI adoption is a people project, not simply a technology project.</p>
        </div>
        <button class="read-more" onclick="toggleBio(this)">Read more</button>
        <div class="creds">
