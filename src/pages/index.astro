<script>
  const bnav=document.querySelectorAll('.bnav-btn');
  const panels=document.querySelectorAll('.panel');
  function goTab(id){
    bnav.forEach(x=>x.classList.toggle('active', x.dataset.tab===id));
    document.querySelectorAll('.menu-drop button')
            .forEach(x=>x.classList.toggle('active', x.dataset.tab===id));
    panels.forEach(p=>p.classList.toggle('active', p.id===id));
    const mw=document.getElementById('menuWrap');
    if(mw) mw.classList.remove('open');
    window.scrollTo({top:0,behavior:'smooth'});
  }
  const mitems=document.querySelectorAll('.menu-drop button');
  bnav.forEach(t=>t.addEventListener('click',()=>goTab(t.dataset.tab)));

  // Top-left dropdown menu
  const menuWrap=document.getElementById('menuWrap');
  function toggleMenu(e){ e.stopPropagation(); menuWrap.classList.toggle('open'); }
  document.addEventListener('click', e=>{
    if(!menuWrap.contains(e.target)) menuWrap.classList.remove('open');
  });
  document.addEventListener('keydown', e=>{
    if(e.key==='Escape') menuWrap.classList.remove('open');
  });

  // Book a call: open Contact and pre-select that service
  function bookCall(service){
    goTab('contact');
    setTimeout(()=>{
      const boxes=document.querySelectorAll('#svcOptions input[type=checkbox]');
      boxes.forEach(b=>{
        if(b.value.replace(/&amp;/g,'&')===service){
          b.checked=true;
          b.closest('.opt').classList.add('sel');
          b.closest('.opt').scrollIntoView({behavior:'smooth',block:'center'});
        }
      });
    },420);
  }

  // Open Services and scroll to one practice
  function goPillar(id){
    bnav.forEach(x=>x.classList.toggle('active', x.dataset.tab==='services'));
    document.querySelectorAll('.menu-drop button')
            .forEach(x=>x.classList.toggle('active', x.dataset.tab==='services'));
    panels.forEach(p=>p.classList.toggle('active', p.id==='services'));
    const mw=document.getElementById('menuWrap'); if(mw) mw.classList.remove('open');
    setTimeout(()=>{ const el=document.getElementById(id); if(el) el.scrollIntoView({behavior:'smooth',block:'start'}); },60);
  }

  // Hide "Read more" where the whole bio already fits
  function tidyBios(){
    document.querySelectorAll('.bio-clip').forEach(c=>{
      const btn=c.nextElementSibling;
      const fits=c.scrollHeight <= c.clientHeight + 4;
      c.classList.toggle('fits', fits);
      if(btn && btn.classList.contains('read-more')) btn.style.display = fits ? 'none' : '';
    });
  }
  window.addEventListener('load', tidyBios);
  window.addEventListener('resize', tidyBios);
  document.querySelectorAll('.bnav-btn,.menu-drop button').forEach(b=>b.addEventListener('click',()=>setTimeout(tidyBios,50)));

  // Read more / less on team bios
  function toggleBio(btn){
    const clip=btn.previousElementSibling;
    const open=clip.classList.toggle('open');
    btn.textContent = t(open ? 'Read less' : 'Read more');
  }

  // Multi-select visual state
  document.addEventListener('change', e=>{
    if(e.target.matches('#svcOptions input[type=checkbox]')){
      e.target.closest('.opt').classList.toggle('sel', e.target.checked);
    }
  });

  // Preloader: hide after page loads, with a short minimum so the animation reads
  const loader=document.getElementById('loader');
  const start=Date.now();
  function hideLoader(){
    const wait=Math.max(0, 3400-(Date.now()-start));
    setTimeout(()=>loader.classList.add('hide'), wait);
  }
  if(document.readyState==='complete'){hideLoader();}
  else{window.addEventListener('load',hideLoader);}
  /* ---------- English / Italian ---------- */
  const IT_DICT = {"Purpose Bridge — Services": "Purpose Bridge — Servizi", "Menu": "Menu", "Home": "Home", "Services": "Servizi", "Team": "Team", "Contact": "Contatti", "Building bridges for social impact.": "Costruiamo ponti per l’impatto sociale.", "Partnerships, experiences and collaboration — connecting corporations, universities and institutions with the expertise, counsel and access they need.": "Partnership, esperienze e collaborazione: mettiamo in contatto aziende, università e istituzioni con le competenze, la consulenza e le relazioni di cui hanno bisogno.", "Our Services": "I nostri servizi", "Let's Connect": "Parliamone", "Who We Are": "Chi siamo", "A boutique advisory firm for a complex world.": "Una boutique advisory per un mondo complesso.", "We connect corporations, universities and institutions with the expertise, counsel and access they need to navigate complexity — across digital risk, curated expertise, cross-border law and global leadership development.": "Mettiamo in contatto aziende, università e istituzioni con le competenze, la consulenza e le relazioni di cui hanno bisogno per affrontare la complessità: rischio digitale, competenze selezionate, diritto internazionale e sviluppo della leadership globale.", "AI, Security & Privacy Consultancy": "Consulenza su AI, sicurezza e privacy", "Cybersecurity, data protection, AI governance and online safety — one advisory team for a complex digital risk landscape.": "Cybersecurity, protezione dei dati, governance dell’AI e sicurezza online: un unico team di consulenza per un panorama di rischi digitali complesso.", "Explore →": "Scopri →", "Speakers Bureau": "Speakers Bureau", "Curated experts for foreign affairs, cultural institutions, universities and museum patron programmes.": "Esperti selezionati per affari esteri, istituzioni culturali, università e programmi per mecenati museali.", "Cross-Border Legacy, Law & Philanthropy": "Patrimonio, diritto e filantropia internazionali", "Business law, institutional compliance and estate planning — one advisory relationship across borders.": "Diritto d’impresa, compliance istituzionale e pianificazione patrimoniale: un’unica relazione di consulenza oltre i confini.", "Global Youth Ambassadors": "Global Youth Ambassadors", "Alumni mentorship and peer support for international university students abroad.": "Mentorship degli alumni e supporto tra pari per studenti universitari internazionali all’estero.", "Four advisory practices. One relationship.": "Quattro aree di consulenza. Un’unica relazione.", "Who We Work With": "Con chi lavoriamo", "One relationship, across borders.": "Un’unica relazione, oltre i confini.", "Clients come to us from every side of the table — and increasingly, from more than one country at once.": "I nostri clienti arrivano da ogni lato del tavolo e, sempre più spesso, da più di un paese contemporaneamente.", "Corporations": "Aziende", "Digital risk, cross-border legal strategy and sponsorship.": "Rischio digitale, strategia legale internazionale e sponsorizzazioni.", "Universities": "Università", "Speakers, compliance and student mentorship programmes.": "Relatori, compliance e programmi di mentorship per studenti.", "Institutions & NGOs": "Istituzioni e ONG", "Governance, advancement and international expertise.": "Governance, sviluppo istituzionale e competenze internazionali.", "Families & Individuals": "Famiglie e privati", "Estate planning, asset protection and legacy giving.": "Pianificazione patrimoniale, tutela del patrimonio e lasciti filantropici.", "Building bridges that create lasting social impact.": "Costruiamo ponti che generano un impatto sociale duraturo.", "Let's talk about which of our practices fits what you're building.": "Parliamo di quale delle nostre aree si adatta a ciò che stai costruendo.", "Start a Conversation": "Iniziamo a parlarne", "What We Do": "Cosa facciamo", "Choose a practice to explore it in detail, or book a call and we'll help you decide which fits.": "Scegli un’area per approfondirla, oppure prenota una call e ti aiuteremo a capire quale fa per te.", "Explore": "Scopri", "Book a call": "Prenota una call", "Practice One": "Area uno", "Cybersecurity, data protection, AI governance and online safety — one advisory team of global experts for organisations navigating a complex digital risk landscape.": "Cybersecurity, protezione dei dati, governance dell’AI e sicurezza online: un unico team di esperti internazionali per le organizzazioni che affrontano un panorama di rischi digitali complesso.", "Cybercrime, Compliance & Investigations": "Criminalità informatica, compliance e indagini", "International cybercrime and corruption investigations, drawing on government and major global technology-company experience, plus compliance and risk management for emerging privacy and technology regulation.": "Indagini internazionali su criminalità informatica e corruzione, basate sull’esperienza maturata nelle istituzioni pubbliche e nelle grandi aziende tecnologiche globali, oltre a compliance e gestione del rischio per le nuove normative su privacy e tecnologia.", "Data Protection & Corporate Governance": "Protezione dei dati e governance societaria", "International data protection compliance, including GDPR and NIS2, paired with board-level legal risk governance for organisations operating across borders.": "Compliance internazionale in materia di protezione dei dati, inclusi GDPR e NIS2, unita alla governance del rischio legale a livello di consiglio di amministrazione per le organizzazioni che operano in più paesi.", "AI Adoption & Readiness": "Adozione dell’AI e preparazione organizzativa", "AI integration and organisational readiness for global teams — real-world strategy and ethical grounding for adopting AI, not just technical deployment.": "Integrazione dell’AI e preparazione organizzativa per team globali: una strategia concreta e solide basi etiche per adottare l’AI, non solo un’implementazione tecnica.", "Online Safety & Cyberharassment Policy": "Sicurezza online e politiche contro il cyberbullismo", "Online safety and cyberharassment policy, including international regulatory work to counter harassment and cyberviolence.": "Sicurezza online e politiche contro le molestie informatiche, incluso il lavoro normativo internazionale per contrastare molestie e violenza online.", "How it works": "Come funziona", "Tell us the challenge": "Raccontaci la sfida", "An audit, a training programme, an ongoing retainer, or a mix — every engagement is different.": "Un audit, un programma di formazione, un incarico continuativo o una combinazione: ogni progetto è diverso.", "We scope, then price": "Definiamo il perimetro, poi il prezzo", "No fixed packages. We scope the engagement to your organisation first.": "Nessun pacchetto predefinito. Prima definiamo il progetto sulla base della tua organizzazione.", "Matched by expertise": "L’esperto giusto", "The right expert, or combination of experts, matched to what you need.": "L’esperto, o la combinazione di esperti, più adatto alle tue esigenze.", "Experts in this practice include": "Tra gli esperti di quest’area:", "and": "e", "Practice Two": "Area due", "Curated experts for foreign affairs, cultural institutions, universities and museum patron programmes, drawn from a global, cross-border network.": "Esperti selezionati per affari esteri, istituzioni culturali, università e programmi per mecenati museali, provenienti da una rete internazionale.", "Culture, Art History & Restoration": "Cultura, storia dell’arte e restauro", "Our highest-yielding, most-requested lane.": "Il nostro ambito più richiesto e di maggior successo.", "AI, Governance & Human Dignity": "AI, governance e dignità umana", "Policy and technology for corporate briefings.": "Politiche e tecnologia per briefing aziendali.", "International Affairs & DEI": "Affari internazionali e DEI", "Business schools, chambers of commerce and diplomatic networks.": "Business school, camere di commercio e reti diplomatiche.", "Academic & Institutional Circuit": "Circuito accademico e istituzionale", "International university lecture series.": "Cicli di conferenze in università internazionali.", "How to book": "Come prenotare", "Tell us about your event": "Raccontaci il tuo evento", "Audience, date, format and budget.": "Pubblico, data, formato e budget.", "We match the right speaker": "Troviamo il relatore giusto", "From our roster, matched by fit.": "Scelto dal nostro roster in base alla compatibilità.", "We handle the rest": "Pensiamo a tutto il resto", "Agreements, fees, travel and logistics.": "Contratti, compensi, viaggi e logistica.", "Practice Three": "Area tre", "Business law, institutional compliance and estate planning are usually three separate relationships with three advisors who never talk to each other. Purpose Bridge coordinates all three.": "Diritto d’impresa, compliance istituzionale e pianificazione patrimoniale richiedono di solito tre relazioni distinte, con tre consulenti che non si parlano mai. Purpose Bridge le coordina tutte e tre.", "International Business Law": "Diritto commerciale internazionale", "Entity structuring, contracts and legal strategy for companies operating in more than one country.": "Strutturazione societaria, contratti e strategia legale per aziende che operano in più di un paese.", "International Law for Universities & NGOs": "Diritto internazionale per università e ONG", "Cross-border legal and advancement programme support for global institutions.": "Supporto legale internazionale e ai programmi di sviluppo per istituzioni globali.", "Estate Planning, Asset Protection & Legacy Giving": "Pianificazione patrimoniale, tutela del patrimonio e lasciti", "Coordinated tax, legal and philanthropic strategy for families and individuals living across borders.": "Strategia fiscale, legale e filantropica coordinata per famiglie e privati che vivono tra più paesi.", "We advise and structure — connecting clients to the right vehicles and outside partners. We don't hold a donor-advised fund, manage a charity, or monitor compliance as an ongoing service. That independence is what keeps our advice ours, not a product's.": "Offriamo consulenza e strutturazione, mettendo in contatto i clienti con gli strumenti e i partner esterni più adatti. Non gestiamo fondi di donazione, enti benefici né servizi continuativi di monitoraggio della compliance. È questa indipendenza a garantire che la nostra consulenza sia davvero nostra, non quella di un prodotto.", "Practice Four": "Area quattro", "Alumni mentorship and peer support for international university students abroad — a programme universities license and companies sponsor.": "Mentorship degli alumni e supporto tra pari per studenti universitari internazionali all’estero: un programma che le università acquisiscono in licenza e le aziende sponsorizzano.", "Global Peer Support Circles": "Gruppi di supporto tra pari", "Weekly, facilitator-led groups addressing homesickness, culture shock and isolation — delivered through cross-border dialogues with trained facilitators.": "Incontri settimanali guidati da facilitatori su nostalgia di casa, shock culturale e isolamento, attraverso dialoghi internazionali con facilitatori formati.", "Alumni Mentorship & Networking": "Mentorship e networking con gli alumni", "A monthly guidance programme from alumni to current students, anchored by an annual in-person Ambassadors Summit.": "Un programma mensile di orientamento dagli alumni agli studenti, con un Ambassadors Summit annuale in presenza.", "How to participate": "Come partecipare", "University License": "Licenza per università", "A flat fee banded by cohort size, up to 100 students, covering both layers, licensing and coordination. Custom, scope-based pricing following a needs assessment.": "Una quota fissa in base alla dimensione del gruppo, fino a 100 studenti, che copre entrambi i livelli, la licenza e il coordinamento. Prezzo personalizzato definito dopo un’analisi delle esigenze.", "Corporate Sponsorship": "Sponsorizzazione aziendale", "“Sponsor a Cohort”: 3–5 executive mentors, Summit visibility and a recruiting pipeline. Priced once we understand your goals.": "“Sponsor a Cohort”: 3–5 mentor dirigenti, visibilità al Summit e un canale di recruiting. Prezzo definito una volta compresi i tuoi obiettivi.", "Our Team": "Il nostro team", "Leadership and a network of global experts — one advisory team.": "Una leadership e una rete di esperti internazionali: un unico team di consulenza.", "Leadership": "Leadership", "Founder & Principal": "Fondatrice e Principal", "Silvia Anna Zamarripa is an American international relations and strategic partnerships leader based in Italy, known for building bridges between institutions, communities, and cultures. Her work spans diplomacy, stakeholder relations, education, cultural heritage, and international cooperation, with a focus on creating opportunities that foster meaningful dialogue, collaboration, and long-term value.": "Silvia Anna Zamarripa è una professionista americana di relazioni internazionali e partnership strategiche con base in Italia, nota per la sua capacità di costruire ponti tra istituzioni, comunità e culture. Il suo lavoro spazia dalla diplomazia alle relazioni con gli stakeholder, dall’istruzione al patrimonio culturale e alla cooperazione internazionale, con l’obiettivo di creare opportunità che favoriscano dialogo, collaborazione e valore nel lungo periodo.", "As Founder and Principal of Purpose Bridge, she helps nonprofits, cultural institutions, educational programs, foundations, and mission-driven organizations transform vision into action — through strategic partnership development, communications, branding, stakeholder relations, and event-led initiatives. Guided by the philosophy of \"Bridging Purpose and Impact,\" the consultancy serves as a catalyst for collaboration across sectors, disciplines, and borders.": "Come fondatrice e Principal di Purpose Bridge, aiuta organizzazioni non profit, istituzioni culturali, programmi educativi, fondazioni e organizzazioni orientate a una missione a trasformare la visione in azione, attraverso lo sviluppo di partnership strategiche, comunicazione, branding, relazioni con gli stakeholder e iniziative legate agli eventi. Guidata dalla filosofia “Bridging Purpose and Impact”, la società di consulenza è un catalizzatore di collaborazione tra settori, discipline e confini.", "Silvia serves as President of the American Club of Rome, leading initiatives that support the integration of Americans and other international residents in Italy through cultural programming, professional networking, and community-building. She also sits on the Board of Directors of the Association of American Clubs, strengthening ties among American clubs worldwide.": "Silvia è Presidente dell’American Club of Rome, dove guida iniziative a sostegno dell’integrazione degli americani e degli altri residenti internazionali in Italia attraverso programmi culturali, networking professionale e attività per la comunità. Siede inoltre nel Consiglio di amministrazione dell’Association of American Clubs, rafforzando i legami tra i club americani nel mondo.", "In 2026 she became a Founding Board Member and President of Global Youth Ambassadors, an international initiative preparing the next generation of leaders through diplomacy, intercultural dialogue, and global citizenship. She also serves as Ambassador to the Americans in Italy for We the Italians, promoting stronger connections between American and Italian communities.": "Nel 2026 è diventata membro fondatore del Consiglio e Presidente di Global Youth Ambassadors, un’iniziativa internazionale che prepara la prossima generazione di leader attraverso la diplomazia, il dialogo interculturale e la cittadinanza globale. È inoltre Ambasciatrice per gli americani in Italia di We the Italians, promuovendo legami più forti tra le comunità americana e italiana.", "A passionate advocate for education and civic responsibility, Silvia established the President's Award for Academic and Community Excellence, an annual recognition honoring students at The American University of Rome who demonstrate both outstanding academic achievement and meaningful contributions to their communities. She also supports cultural heritage initiatives encouraging conservation, public awareness, and responsible stewardship of Italy's historic and artistic treasures.": "Appassionata sostenitrice dell’istruzione e dell’impegno civico, Silvia ha istituito il President’s Award for Academic and Community Excellence, un riconoscimento annuale per gli studenti della American University of Rome che si distinguono sia per risultati accademici sia per il contributo alle proprie comunità. Sostiene inoltre iniziative per il patrimonio culturale che promuovono la conservazione, la sensibilizzazione del pubblico e la tutela responsabile dei tesori storici e artistici d’Italia.", "Read more": "Leggi di più", "Leadership & Affiliations": "Incarichi e affiliazioni", "President": "Presidente", "Board of Directors": "Consiglio di amministrazione", "President & Founding Board Member": "Presidente e membro fondatore del Consiglio", "Delegate for Texas": "Delegata per il Texas", "Confassociazioni — Italian Confederation of Professional Associations": "Confassociazioni — Confederazione Associazioni Professionali", "Principal, Strategic Partnerships": "Principal, Partnership strategiche", "Linda Spencer brings over two decades of strategy, operations and development leadership across the United States and Europe. She currently advises and supports global teams on systems streamlining and AI integration.": "Linda Spencer vanta oltre vent’anni di esperienza di leadership in strategia, operations e sviluppo tra Stati Uniti ed Europa. Attualmente affianca team globali nella semplificazione dei processi e nell’integrazione dell’AI.", "Before her consulting work, she raised more than $200 million working with high-net-worth boards on major gifts, estate and legacy planning, and capital campaigns at Covenant House International, the Inner-City Scholarship Fund and the Archdiocese of New York.": "Prima dell’attività di consulenza ha raccolto oltre 200 milioni di dollari lavorando con consigli di amministrazione di alto profilo su grandi donazioni, pianificazione patrimoniale e lasciti e campagne di raccolta fondi presso Covenant House International, l’Inner-City Scholarship Fund e l’Arcidiocesi di New York.", "Having lived or worked in more than eight countries across the Americas and Europe, she brings a genuinely cross-border lens to client engagements. Linda holds a Master of Arts in Social and Organizational Psychology from Columbia University's Teachers College and a Bachelor of Arts from St. John's University.": "Avendo vissuto o lavorato in più di otto paesi tra le Americhe e l’Europa, porta nei progetti con i clienti una prospettiva autenticamente internazionale. Linda ha conseguito un Master of Arts in Psicologia sociale e organizzativa presso il Teachers College della Columbia University e un Bachelor of Arts presso la St. John’s University.", "Education & Background": "Formazione ed esperienza", "M.A., Social & Organizational Psychology": "Master in Psicologia sociale e organizzativa", "Development leadership": "Leadership nel fundraising", "Current focus": "Ambito attuale", "Systems streamlining & AI integration for global teams": "Semplificazione dei processi e integrazione dell’AI per team globali", "Senior Advisor, Strategic Partnerships": "Senior Advisor, Partnership strategiche", "Savas brings multidisciplinary experience across business development and complex negotiations with discerning international clients. He works with strategic partners across the United States and Europe, spanning key markets including Dubai, Hong Kong, New York, Miami, London, Paris, Berlin, Geneva and Luxembourg.": "Savas vanta un’esperienza multidisciplinare nello sviluppo commerciale e nelle negoziazioni complesse con clienti internazionali esigenti. Lavora con partner strategici tra Stati Uniti ed Europa, su mercati chiave come Dubai, Hong Kong, New York, Miami, Londra, Parigi, Berlino, Ginevra e Lussemburgo.", "Before his consulting work, Savas held roles at Fortune 500 companies, where he developed his approach to understanding client objectives and building solutions around them.": "Prima dell’attività di consulenza ha ricoperto ruoli in aziende Fortune 500, dove ha sviluppato il suo approccio: comprendere gli obiettivi del cliente e costruire le soluzioni intorno a essi.", "His practice rests on the conviction that a strong business partnership is built on responsiveness, credibility, trust and integrity — not on the transaction alone.": "Il suo lavoro si fonda sulla convinzione che una solida partnership commerciale si costruisca su disponibilità, credibilità, fiducia e integrità, non sulla sola transazione.", "Focus & Markets": "Ambiti e mercati", "Practice": "Attività", "Business development & complex negotiations": "Sviluppo commerciale e negoziazioni complesse", "Background": "Esperienza", "Fortune 500 companies": "Aziende Fortune 500", "Americas & Asia": "Americhe e Asia", "Europe": "Europa", "London · Paris · Berlin · Geneva · Luxembourg": "Londra · Parigi · Berlino · Ginevra · Lussemburgo", "Expert Network": "Rete di esperti", "Cristina Posa is a lawyer and leader with two decades of experience on the cutting edge of technology and international investigations. A graduate of Harvard Law School and Johns Hopkins University, she served as a U.S. federal prosecutor in New York, where she founded the office's cybercrime unit, and then as the U.S. Department of Justice Attaché to the U.S. Embassy in Rome.": "Cristina Posa è un’avvocata e leader con vent’anni di esperienza all’avanguardia nella tecnologia e nelle indagini internazionali. Laureata alla Harvard Law School e alla Johns Hopkins University, è stata procuratrice federale degli Stati Uniti a New York, dove ha fondato l’unità dedicata alla criminalità informatica, e poi Addetta del Dipartimento di Giustizia degli Stati Uniti presso l’Ambasciata americana a Roma.", "Among other honours, Cristina won the Prosecutor of the Year award from the Federal Law Enforcement Foundation for dismantling a complex cybercrime syndicate. After more than a decade of public service, she founded and led Amazon's Counterfeit Crimes Unit and then led a legal team at Meta for Europe, the Middle East and Africa.": "Tra i vari riconoscimenti, Cristina ha ricevuto il premio Prosecutor of the Year dalla Federal Law Enforcement Foundation per aver smantellato una complessa organizzazione di criminalità informatica. Dopo oltre dieci anni di servizio pubblico, ha fondato e guidato la Counterfeit Crimes Unit di Amazon e poi un team legale di Meta per Europa, Medio Oriente e Africa.", "She is currently a Cybercrime Expert for the Council of Europe, where her projects include working with Ukraine to use digital evidence in war crimes cases, and a Senior Advisor in the Forensic Investigations and Intelligence practice at RSM Italy. She is also a Lecturer in Law at John Cabot University in Rome, teaching the law and politics of artificial intelligence and cybersecurity, and publishes on emerging issues in cybersecurity, AI and international investigations.": "Attualmente è Esperta di criminalità informatica per il Consiglio d’Europa, dove tra i suoi progetti c’è la collaborazione con l’Ucraina sull’uso delle prove digitali nei processi per crimini di guerra, e Senior Advisor nella practice Forensic Investigations and Intelligence di RSM Italy. È inoltre docente di Diritto alla John Cabot University di Roma, dove insegna diritto e politica dell’intelligenza artificiale e della cybersecurity, e pubblica su temi emergenti di cybersecurity, AI e indagini internazionali.", "Current Roles & Education": "Incarichi attuali e formazione", "Cybercrime Expert": "Esperta di criminalità informatica", "Council of Europe": "Consiglio d’Europa", "Senior Advisor, Forensic Investigations & Intelligence": "Senior Advisor, Indagini forensi e intelligence", "Lecturer in Law": "Docente di Diritto", "John Cabot University, Rome": "John Cabot University, Roma", "Education": "Formazione", "Founder & CEO, The Orange Peel Collaborative": "Fondatrice e CEO, The Orange Peel Collaborative", "Tia helps municipalities, nonprofits and businesses adopt emerging technologies responsibly — through AI governance, workplace transformation and practical implementation strategy.": "Tia aiuta comuni, organizzazioni non profit e aziende ad adottare le tecnologie emergenti in modo responsabile, attraverso la governance dell’AI, la trasformazione del lavoro e strategie di implementazione concrete.", "A U.S. Navy veteran recognised by the Obama White House as a Woman Veteran Champion of Change, she most recently supported the City of Pittsburgh's generative AI rollout.": "Veterana della Marina degli Stati Uniti, riconosciuta dalla Casa Bianca di Obama come Woman Veteran Champion of Change, ha recentemente affiancato la città di Pittsburgh nell’introduzione dell’AI generativa.", "Her approach rests on one principle: successful AI adoption is a people project, not simply a technology project.": "Il suo approccio si basa su un principio: adottare l’AI con successo è un progetto che riguarda le persone, non solo la tecnologia.", "Focus & Recognition": "Ambiti e riconoscimenti", "Focus": "Ambito", "AI adoption, governance & workplace transformation": "Adozione dell’AI, governance e trasformazione del lavoro", "Recent work": "Progetto recente", "City of Pittsburgh generative AI rollout": "Introduzione dell’AI generativa per la città di Pittsburgh", "Recognition": "Riconoscimento", "Woman Veteran Champion of Change, Obama White House": "Woman Veteran Champion of Change, Casa Bianca di Obama", "Service": "Servizio", "U.S. Navy veteran": "Veterana della Marina degli Stati Uniti", "Let's start a conversation.": "Iniziamo a parlarne.", "Tell us which practices fit what you're building. We'll scope the engagement with you before anything is priced.": "Dicci quali aree si adattano a ciò che stai costruendo. Definiremo insieme il progetto prima di qualsiasi preventivo.", "Email": "Email", "Based in": "Sede", "Rome, Italy — working across Europe & the U.S.": "Roma, Italia — operiamo tra Europa e Stati Uniti", "Web": "Web", "Service Inquiry": "Richiesta di consulenza", "First name": "Nome", "Last name": "Cognome", "Company name": "Azienda / organizzazione", "Phone number": "Telefono", "Which practices are you interested in?": "Quali aree ti interessano?", "(select all that apply)": "(puoi selezionarne più di una)", "Many clients combine practices — select all that apply, or leave them blank and we'll advise.": "Molti clienti combinano più aree: selezionale tutte, oppure lasciale vuote e ti consiglieremo noi.", "Add a message or tell us more about what you need": "Aggiungi un messaggio o raccontaci di cosa hai bisogno", "Yes, subscribe me to your newsletter.": "Sì, desidero iscrivermi alla newsletter.", "Send Request": "Invia richiesta", "Covenant House International · Inner-City Scholarship Fund · Archdiocese of New York": "Covenant House International · Inner-City Scholarship Fund · Arcidiocesi di New York", "Read less": "Leggi meno", "This is a prototype — in Wix this connects to your form submissions.": "Questo è un prototipo: in Wix il modulo sarà collegato alle richieste ricevute."};
  let LANG = 'en';
  const ORIG = new WeakMap();
  function t(s){ return LANG==='it' && IT_DICT[s] ? IT_DICT[s] : s; }
  function norm(s){ return s.replace(/\s+/g,' ').trim(); }

  function translateTree(root){
    const walker=document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
      acceptNode(n){
        const p=n.parentElement;
        if(!p || p.closest('script,style,svg,.read-more,.lang-switch,.form-status')) return NodeFilter.FILTER_REJECT;
        return /[A-Za-z]/.test(n.nodeValue) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
      }});
    const nodes=[]; while(walker.nextNode()) nodes.push(walker.currentNode);
    nodes.forEach(n=>{
      if(!ORIG.has(n)) ORIG.set(n, n.nodeValue);
      const o=ORIG.get(n), key=norm(o);
      if(LANG==='it' && IT_DICT[key]){
        const lead=o.match(/^\s*/)[0], trail=o.match(/\s*$/)[0];
        n.nodeValue = lead + IT_DICT[key] + trail;
      } else n.nodeValue = o;
    });
    root.querySelectorAll('[placeholder],[aria-label]').forEach(el=>{
      ['placeholder','aria-label'].forEach(a=>{
        if(!el.hasAttribute(a)) return;
        const k='data-en-'+a;
        if(!el.hasAttribute(k)) el.setAttribute(k, el.getAttribute(a));
        el.setAttribute(a, t(el.getAttribute(k)));
      });
    });
  }

  function setLang(l){
    LANG = (l==='it') ? 'it' : 'en';
    document.documentElement.lang = LANG;
    translateTree(document.body);
    document.title = t('Purpose Bridge — Services');
    document.querySelectorAll('.read-more').forEach(b=>{
      const open=b.previousElementSibling && b.previousElementSibling.classList.contains('open');
      b.textContent = t(open ? 'Read less' : 'Read more');
    });
    document.querySelectorAll('.lang-switch button').forEach(b=>b.classList.toggle('on', b.dataset.lang===LANG));
    try{ localStorage.setItem('pb-lang', LANG); }catch(e){}
    if(typeof tidyBios==='function') setTimeout(tidyBios,30);
    if(typeof renderStatus==='function') renderStatus();
  }

  // first visit: follow the browser's language; afterwards remember the visitor's choice
  (function(){
    let saved=null; try{ saved=localStorage.getItem('pb-lang'); }catch(e){}
    const browser=(navigator.language||'en').toLowerCase().startsWith('it') ? 'it' : 'en';
    setLang(saved || browser);
  })();
  /* ---------- Contact form -> info@purposebridge.it (via FormSubmit) ---------- */
  const FORM_ENDPOINT = 'https://formsubmit.co/ajax/info@purposebridge.it';
  Object.assign(IT_DICT, {
    "Please fill in the highlighted fields.":"Compila i campi evidenziati.",
    "Please enter a valid email address.":"Inserisci un indirizzo email valido.",
    "Sending your request…":"Invio della richiesta in corso…",
    "Thank you — your request has been sent. We'll be in touch shortly.":"Grazie, la tua richiesta è stata inviata. Ti contatteremo a breve.",
    "Sorry, the message couldn't be sent. Please email us directly at":"Non è stato possibile inviare il messaggio. Scrivici direttamente a"
  });
  function showStatus(kind, key, withEmail){
    const statusEl=document.getElementById('formStatus');
    statusEl.className = 'form-status ' + kind;
    statusEl.dataset.key = key; statusEl.dataset.mail = withEmail ? '1' : '';
    renderStatus();
  }
  function renderStatus(){
    const statusEl=document.getElementById('formStatus');
    if(!statusEl || !statusEl.dataset.key) return;
    statusEl.textContent = t(statusEl.dataset.key);
    if(statusEl.dataset.mail){
      statusEl.append(' ');
      const a=document.createElement('a'); a.href='mailto:info@purposebridge.it'; a.textContent='info@purposebridge.it';
      statusEl.append(a, '.');
    }
  }
  function val(id){ return (document.getElementById(id).value || '').trim(); }

  async function sendInquiry(){
    const need=['f-first','f-last','f-phone','f-email'];
    document.querySelectorAll('.field.invalid').forEach(f=>f.classList.remove('invalid'));
    const missing=need.filter(id=>!val(id));
    missing.forEach(id=>document.getElementById(id).closest('.field').classList.add('invalid'));
    if(missing.length){ showStatus('err','Please fill in the highlighted fields.'); document.getElementById(missing[0]).focus(); return; }
    if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val('f-email'))){
      document.getElementById('f-email').closest('.field').classList.add('invalid');
      showStatus('err','Please enter a valid email address.'); return;
    }
    const practices=[...document.querySelectorAll('#svcOptions input:checked')].map(b=>b.value);
    const payload={
      _subject: 'New enquiry from the Purpose Bridge website — ' + val('f-first') + ' ' + val('f-last'),
      _template: 'table',
      _honey: val('f-honey'),
      Name: val('f-first') + ' ' + val('f-last'),
      Company: val('f-company') || '—',
      Phone: val('f-phone'),
      email: val('f-email'),
      Practices: practices.length ? practices.join(', ') : 'Not specified',
      Message: val('f-msg') || '—',
      Newsletter: document.getElementById('f-news').checked ? 'Yes' : 'No',
      'Site language': LANG === 'it' ? 'Italian' : 'English'
    };
    const btn=document.getElementById('f-submit');
    btn.disabled=true; showStatus('info','Sending your request…');
    try{
      const r=await fetch(FORM_ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(payload)});
      const d=await r.json().catch(()=>({}));
      if(!r.ok || String(d.success)==='false') throw new Error(d.message||r.status);
      showStatus('ok',"Thank you — your request has been sent. We'll be in touch shortly.");
      ['f-first','f-last','f-company','f-phone','f-email','f-msg'].forEach(id=>document.getElementById(id).value='');
      document.querySelectorAll('#svcOptions input, #f-news').forEach(b=>{b.checked=false; const o=b.closest('.opt'); if(o) o.classList.remove('sel');});
    }catch(e){
      showStatus('err','Sorry, the message couldn\'t be sent. Please email us directly at', true);
    }finally{ btn.disabled=false; }
  }
</script>


