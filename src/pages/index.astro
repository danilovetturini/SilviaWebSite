---
import Layout from '../layouts/Layout.astro';
---
<Layout>
    

  <div id="loader">
    <div class="assembly">
      <img class="ly-globe"  src="data:image/png;base64,"  alt="">
      <img class="ly-bridge" src="data:image/png;base64," alt="">
      <img class="ly-word"   src="data:image/png;base64,"   alt="Purpose Bridge">
      <img class="ly-adv"    src="data:image/png;base64,"    alt="Advisory">
    </div>
  </div>


<header>
  <div class="brand"><img src="data:image/png;base64," alt="Purpose Bridge"></div>
</header>

<main class="wrap">

  <!-- ================= HOME ================= -->
  <section class="panel active" id="home">
    <section class="hero">
      <div class="hero-inner">
        <h1>We build bridges between purpose and impact.</h1>
        <p>A boutique advisory connecting nonprofits, foundations, universities, governments, and corporate partners across borders — through strategy, events, and lasting relationships.</p>
        <div class="hero-btns">
          <button class="btn-primary" onclick="goTab('services')">Our Services</button>
          <button class="btn-ghost" onclick="goTab('contact')">Let's Connect</button>
        </div>
      </div>
    </section>

    <div class="home-intro">
      <div class="eyebrow">Who We Are</div>
      <h2>Bridging purpose and impact.</h2>
      <p>A boutique advisory connecting nonprofits, foundations, universities, governments, and corporate partners — across sectors, disciplines, and borders.</p>
    </div>

    <!-- gateways to detail pages -->
    <div class="gateways">
      <div class="gate">
        <div class="g-icon"><svg viewBox="0 0 24 24"><path d="M9 3h6M4 8h16v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zM4 8l2-4h12l2 4"/></svg></div>
        <h3>Our Services</h3>
        <p>Strategy, planning, fundraising, marketing and partnership engagement — end to end.</p>
        <button onclick="goTab('services')">Explore Services</button>
      </div>
      <div class="gate">
        <div class="g-icon"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg></div>
        <h3>Events We Deliver</h3>
        <p>Galas, conferences, cultural programming and networking that move missions forward.</p>
        <button onclick="goTab('events')">Explore Events</button>
      </div>
      <div class="gate">
        <div class="g-icon"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M16 3.5a3 3 0 0 1 0 5.8M21 20c0-2.5-1.5-4.7-3.7-5.6"/></svg></div>
        <h3>Our Team</h3>
        <p>Decades of international relations, philanthropy and cross-border partnership leadership.</p>
        <button onclick="goTab('team')">Meet the Team</button>
      </div>
    </div>

    <!-- reach / impact -->
    <div class="reach">
      <div class="eyebrow">Our Reach</div>
      <h2>Connecting purpose to the people who power it.</h2>
      <p>We bring together donors, corporate partners, academic institutions, governments and communities — extending every organization's reach far beyond a single initiative.</p>
      <div class="stats">
        <div class="stat"><div class="num">6</div><div class="lbl">Core service areas</div></div>
        <div class="stat"><div class="num">4</div><div class="lbl">Event specialties</div></div>
        <div class="stat"><div class="num">360°</div><div class="lbl">Full-service delivery</div></div>
        <div class="stat"><div class="num">100%</div><div class="lbl">Mission-driven</div></div>
      </div>
    </div>

    <div class="home-cta">
      <h3>Let's build something purposeful together.</h3>
      <p>Whether it's a fundraiser, a conference or a community event — we're here to help.</p>
      <button onclick="goTab('contact')">Start a Service Inquiry</button>
    </div>
  </section>


  <!-- ================= SERVICES ================= -->
  <section class="panel" id="services">
    <div class="panel-head">
      <div class="eyebrow">What We Offer</div>
      <h2>Our Services</h2>
      <p>Strategic partnerships that transform purpose into lasting impact. Hover any service to see what's included.</p>
    </div>
    <div class="grid">
      <div class="card">
        <div class="photo-wrap"><img class="photo" src="data:image/jpeg;base64," alt="Event Strategy" loading="lazy"></div>
        <div class="card-body">
        <div class="icon"><svg viewBox="0 0 24 24"><path d="M12 3v18M12 3l7 3-7 3"/></svg></div>
        <h3>Event Strategy</h3>
        <p class="teaser">Expert consulting to align your vision with measurable community impact.</p>
        <div class="detail"><ul>
          <li>Goal &amp; audience definition</li>
          <li>Impact measurement frameworks</li>
          <li>Experience design consulting</li>
        </ul></div>
        <div class="hint">Hover for details</div>
        <button class="book-btn" onclick="bookCall('Our Services')">Book a call</button>
      </div></div>
      <div class="card">
        <div class="photo-wrap"><img class="photo" src="data:image/jpeg;base64," alt="Planning &amp; Logistics" loading="lazy"></div>
        <div class="card-body">
        <div class="icon"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4M9 15l2 2 4-4"/></svg></div>
        <h3>Planning &amp; Logistics</h3>
        <p class="teaser">Full-service planning for a seamless and impactful experience.</p>
        <div class="detail"><ul>
          <li>Venue sourcing &amp; vendor management</li>
          <li>Timeline &amp; budget coordination</li>
          <li>Guest &amp; RSVP management</li>
        </ul></div>
        <div class="hint">Hover for details</div>
        <button class="book-btn" onclick="bookCall('Planning & Logistics')">Book a call</button>
      </div></div>
      <div class="card">
        <div class="photo-wrap"><img class="photo" src="data:image/jpeg;base64," alt="Fundraising Events" loading="lazy"></div>
        <div class="card-body">
        <div class="icon"><svg viewBox="0 0 24 24"><path d="M20 8a4 4 0 0 0-7-2.6A4 4 0 0 0 6 8c0 4 6 8 7 9 1-1 7-5 7-9z"/><path d="M3 13h4l1-2 2 4 1-2h3"/></svg></div>
        <h3>Fundraising Events</h3>
        <p class="teaser">Galas and donor experiences that maximize your mission giving.</p>
        <div class="detail"><ul>
          <li>Gala &amp; auction design</li>
          <li>Donor journey mapping</li>
          <li>Giving-moment choreography</li>
        </ul></div>
        <div class="hint">Hover for details</div>
        <button class="book-btn" onclick="bookCall('Fundraising Events')">Book a call</button>
      </div></div>
      <div class="card">
        <div class="photo-wrap"><img class="photo" src="data:image/jpeg;base64," alt="Marketing Reach" loading="lazy"></div>
        <div class="card-body">
        <div class="icon"><svg viewBox="0 0 24 24"><path d="M3 11l14-7v16L3 13zM3 11v2M8 12v6l3 1"/></svg></div>
        <h3>Marketing Reach</h3>
        <p class="teaser">Strategic communications that amplify your story and drive engagement.</p>
        <div class="detail"><ul>
          <li>Campaign &amp; content strategy</li>
          <li>Social &amp; email amplification</li>
          <li>Press &amp; partner outreach</li>
        </ul></div>
        <div class="hint">Hover for details</div>
        <button class="book-btn" onclick="bookCall('Marketing Reach')">Book a call</button>
      </div></div>
      <div class="card">
        <div class="photo-wrap"><img class="photo" src="data:image/jpeg;base64," alt="On-site Logistics" loading="lazy"></div>
        <div class="card-body">
        <div class="icon"><svg viewBox="0 0 24 24"><path d="M3 21V9l9-6 9 6v12M9 21v-6h6v6"/><circle cx="15" cy="10" r="1.5"/></svg></div>
        <h3>On-site Logistics</h3>
        <p class="teaser">Seamless day-of management so your focus stays on your guests.</p>
        <div class="detail"><ul>
          <li>Run-of-show coordination</li>
          <li>Staff &amp; volunteer direction</li>
          <li>Real-time problem solving</li>
        </ul></div>
        <div class="hint">Hover for details</div>
        <button class="book-btn" onclick="bookCall('On-site Logistics')">Book a call</button>
      </div></div>
      <div class="card">
        <div class="photo-wrap"><img class="photo" src="data:image/jpeg;base64," alt="Partnership Engagement" loading="lazy"></div>
        <div class="card-body">
        <div class="icon"><svg viewBox="0 0 24 24"><path d="M8 11l3 3 5-6M2 13l4 4 3-3M13 13l3 3 5-7"/></svg></div>
