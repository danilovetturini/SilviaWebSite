        <div class="detail"><ul>
          <li>Sponsor &amp; partner cultivation</li>
          <li>Stewardship programs</li>
          <li>Long-term retention planning</li>
        </ul></div>
        <div class="hint">Hover for details</div>
        <button class="book-btn" onclick="bookCall('Partnership Engagement')">Book a call</button>
      </div></div>
    </div>
  </section>

  <!-- ================= PILLARS ================= -->
  <section class="panel" id="pillars">
    <div class="panel-head">
      <div class="eyebrow">How We Work</div>
