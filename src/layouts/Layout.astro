---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
    title?: string;
    lang?: string;
}

const { title = 'Purpose Bridge — Services', lang = 'en' } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
    
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Karla:wght@300;400;500;600&display=swap" rel="stylesheet">


</head>
<body>
    <slot />
    <Footer />
</body>
</html>
